# Sentiment Dashboard - Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================
# Required APIs
# ============================================

# NewsAPI - Get free API key from https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Minimax AI - For AI Agent functionality
# Get from https://www.minimaxi.com/
MINIMAX_API_KEY=your_minimax_api_key_here

# ============================================
# Reddit API (Optional - for official API access)
# If not provided, will use public JSON API
# Apply at https://www.reddit.com/wiki/api
# ============================================
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# ============================================
# Alpaca Trading (Optional - for trading features)
# Get paper trading keys from https://alpaca.markets/
# ============================================
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================================
# Twitter/X API (Optional - for Twitter sentiment)
# Apply at https://developer.twitter.com/
# ============================================
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ============================================
# Stitch UI (Optional - for AI-generated UI)
# Get from https://stitch.design/
# ============================================
STITCH_API_KEY=your_stitch_api_key

# ============================================
# Application Settings
# ============================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend settings
FRONTEND_URL=http://localhost:3000

# Cron job settings (for auto-iteration)
CRON_ENABLED=true
CRON_INTERVAL_MINUTES=15

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Cache settings
CACHE_TTL_SECONDS=300
